# Docker Environment Configuration for Grab Subtitle Service
# Copy this file to docker.env and fill in your values

# =============================================================================
# REQUIRED: API Credentials
# =============================================================================

# OpenSubtitles API credentials
OPENSUBTITLES_USERNAME=your_opensubtitles_username
OPENSUBTITLES_PASSWORD=your_opensubtitles_password

# OpenAI API key for translation
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# OPTIONAL: Service Configuration
# =============================================================================

# Target language for subtitles (default: he for Hebrew)
# Supported: he, es, fr, de, it, pt, ru, ja, ko, zh, ar
TARGET_LANGUAGE=he

# =============================================================================
# OPTIONAL: Directory Paths (Docker Volumes)
# =============================================================================

# Directory containing videos to monitor (relative to docker-compose.yml)
VIDEO_DIRECTORY=./videos

# Directory where subtitles will be saved
SUBTITLE_OUTPUT=./subtitles

# Directory for configuration files
CONFIG_DIR=./config

# Directory for database and persistent data
DATA_DIR=./data

# Directory for log files
LOGS_DIR=./logs

# Directory for cache files
CACHE_DIR=./cache

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# Internal directory path (used inside container)
DIRECTORY_PATH=/media/videos

# =============================================================================
# HomeLab Specific Settings
# =============================================================================

# Uncomment and modify these for specific HomeLab setups:

# For Synology NAS:
# VIDEO_DIRECTORY=/volume1/video
# SUBTITLE_OUTPUT=/volume1/subtitles
# DATA_DIR=/volume1/docker/grab-subtitle/data
# LOGS_DIR=/volume1/docker/grab-subtitle/logs

# For TrueNAS:
# VIDEO_DIRECTORY=/mnt/tank/videos
# SUBTITLE_OUTPUT=/mnt/tank/subtitles
# DATA_DIR=/mnt/tank/docker/grab-subtitle/data
# LOGS_DIR=/mnt/tank/docker/grab-subtitle/logs

# For Unraid:
# VIDEO_DIRECTORY=/mnt/user/videos
# SUBTITLE_OUTPUT=/mnt/user/subtitles
# DATA_DIR=/mnt/user/appdata/grab-subtitle/data
# LOGS_DIR=/mnt/user/appdata/grab-subtitle/logs

# For Proxmox LXC:
# VIDEO_DIRECTORY=/mnt/videos
# SUBTITLE_OUTPUT=/mnt/subtitles
# DATA_DIR=/var/lib/grab-subtitle/data
# LOGS_DIR=/var/log/grab-subtitle 