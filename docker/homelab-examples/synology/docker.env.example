# Synology NAS - Docker Environment Configuration
# Copy this file to docker.env and fill in your values

# =============================================================================
# REQUIRED: API Credentials
# =============================================================================

# OpenSubtitles API credentials
OPENSUBTITLES_USERNAME=your_opensubtitles_username
OPENSUBTITLES_PASSWORD=your_opensubtitles_password

# OpenAI API key for translation
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# OPTIONAL: Service Configuration
# =============================================================================

# Target language for subtitles (default: he for Hebrew)
# Supported: he, es, fr, de, it, pt, ru, ja, ko, zh, ar
TARGET_LANGUAGE=he

# =============================================================================
# Synology NAS Specific Settings
# =============================================================================

# Synology volume paths (adjust based on your setup)
# Default volume is /volume1, change if you use different volume
VIDEO_DIRECTORY=/volume1/video
SUBTITLE_OUTPUT=/volume1/subtitles
CONFIG_DIR=/volume1/docker/grab-subtitle/config
DATA_DIR=/volume1/docker/grab-subtitle/data
LOGS_DIR=/volume1/docker/grab-subtitle/logs
CACHE_DIR=/volume1/docker/grab-subtitle/cache

# =============================================================================
# Synology Setup Instructions
# =============================================================================

# 1. Create directories in Synology File Station:
#    - /volume1/video (your video files)
#    - /volume1/subtitles (subtitle output)
#    - /volume1/docker/grab-subtitle/config
#    - /volume1/docker/grab-subtitle/data
#    - /volume1/docker/grab-subtitle/logs
#    - /volume1/docker/grab-subtitle/cache

# 2. Set proper permissions:
#    - Right-click on directories in File Station
#    - Properties -> Permissions
#    - Add "docker" user with read/write permissions

# 3. Install Docker package from Package Center if not already installed

# 4. Use Synology Docker GUI or SSH to run:
#    docker-compose up -d

# =============================================================================
# Alternative Volume Paths
# =============================================================================

# If you use a different volume (e.g., /volume2):
# VIDEO_DIRECTORY=/volume2/video
# SUBTITLE_OUTPUT=/volume2/subtitles
# CONFIG_DIR=/volume2/docker/grab-subtitle/config
# DATA_DIR=/volume2/docker/grab-subtitle/data
# LOGS_DIR=/volume2/docker/grab-subtitle/logs
# CACHE_DIR=/volume2/docker/grab-subtitle/cache

# If you use shared folders:
# VIDEO_DIRECTORY=/volume1/@appstore/Docker/video
# SUBTITLE_OUTPUT=/volume1/@appstore/Docker/subtitles
# CONFIG_DIR=/volume1/@appstore/Docker/grab-subtitle/config
# DATA_DIR=/volume1/@appstore/Docker/grab-subtitle/data
# LOGS_DIR=/volume1/@appstore/Docker/grab-subtitle/logs
# CACHE_DIR=/volume1/@appstore/Docker/grab-subtitle/cache 